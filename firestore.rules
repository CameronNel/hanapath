rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid}/backups/{backupId} {
      allow read, delete: if owns(uid);
      allow create, update: if owns(uid)
        && backupId == 'current'
        && request.resource.data.keys().hasOnly([
          'schemaVersion',
          'stateJson',
          'checksum',
          'deviceId',
          'source',
          'updatedAt',
          'updatedAtMillis'
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.stateJson is string
        && request.resource.data.stateJson.size() <= 850000
        && request.resource.data.checksum is string
        && request.resource.data.deviceId is string
        && request.resource.data.source in ['web', 'android']
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedAtMillis is int;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
