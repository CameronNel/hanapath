<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Never expose all of external storage or the whole cache directory.
         Native sharing must stage an explicit file inside one of these narrow
         app-owned subdirectories before granting a temporary content URI. -->
    <files-path name="hanapath_exports" path="exports/" />
    <cache-path name="hanapath_shared_cache" path="shared/" />
</paths>
